# ─── LLM Provider Selection ────────────────────────────────────────────────────
# Set to "openai" or "anthropic"
LLM_PROVIDER=openai

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Legacy (MiniMax via OpenAI-compatible endpoint) ──────────────────────────
# MINIMAX_API_KEY=your_minimax_api_key_here
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-Text-01

# ─── Auth (leave empty for open access in dev) ────────────────────────────────
API_KEY=

# ─── CORS (use * for dev, set your domain for prod) ──────────────────────────
CORS_ORIGIN=*

# ─── Rate limiting ────────────────────────────────────────────────────────────
WS_RATE_MAX=30
WS_RATE_WINDOW_MS=60000

# ─── Graph execution timeout in ms (default 5 min) ───────────────────────────
GRAPH_TIMEOUT_MS=300000

# ─── Persistence (JSON file path) ────────────────────────────────────────────
DB_PATH=./data/projects.json

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
