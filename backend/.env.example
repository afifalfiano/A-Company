# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Auth (leave empty for open access in dev) ────────────────────────────────
API_KEY=

# ─── CORS (use * for dev, set your domain for prod) ──────────────────────────
CORS_ORIGIN=*

# ─── Rate limiting ────────────────────────────────────────────────────────────
WS_RATE_MAX=30
WS_RATE_WINDOW_MS=60000

# ─── Graph execution timeout in ms (default 5 min) ───────────────────────────
GRAPH_TIMEOUT_MS=300000

# ─── Persistence (JSON file path) ────────────────────────────────────────────
DB_PATH=./data/projects.json

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
